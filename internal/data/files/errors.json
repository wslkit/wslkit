  "codes": {
    "E_UNEXPECTED": {
      "hresult": "0x8000FFFF",
      "desc": "Catastrophic failure. A generic bucket: the service hit something it did not expect, most often the distro failing to boot.",
      "probes": [
        "WSL001",
        "DSK002",
        "PLG001"
      ],
      "causes": [
        {
          "summary": "runtime too old for a cgroup-v2-only distro (e.g. Ubuntu 26.04 on WSL < 2.5.7)",
          "probes": [
            "WSL001"
          ],
          "refs": [
            "https://github.com/microsoft/WSL/releases/tag/2.5.1"
          ]
        },
        {
          "summary": "corrupted root filesystem: dmesg shows EXT4-fs checksum errors and /sbin/init cannot load libc",
          "probes": [
            "DSK002"
          ],
          "refs": [
            "https://github.com/microsoft/WSL/issues/13484"
          ]
        },
        {
          "summary": "a host plugin failed to load",
          "probes": [
            "PLG001"
          ]
        }
      ]
    },
